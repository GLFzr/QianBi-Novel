      "fills": [
        {
          "target": "cwInput",
          "value": "「种子书」的规则再收紧一点：写下的预言必须付出等价代价，父亲当年用过吗？"
        }
      ]
    },
    {
      "id": "cw_send",
      "mode": "user_click",
      "target": "cwSendButton",
      "text": "点「发送」。"
    },
    {
      "id": "cw_write_fill",
      "mode": "fill_seq",
      "target": "cwInput",
      "text": "再来一轮：这次让 AI 直接产出正文草稿（撰写）。",
      "fills": [
        {
          "target": "cwInput",
